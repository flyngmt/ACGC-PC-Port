+/* Project extension: a detached pad must not retain stale input packets. */
+void ac_usb_input_disconnect(int port) {
+    if (port < 0 || port >= 4) return;
+    struct controller_data_s empty = {0};
+    ctrl[port] = empty;
+    valid[port] = 0;
+}
