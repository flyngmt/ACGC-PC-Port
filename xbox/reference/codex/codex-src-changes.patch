+
+#ifdef AC_SCENE_ACTOR_LIST
+#include "xbox360/scene_actor_list.h"
+_Static_assert(sizeof(Actor_list)==8&&__builtin_offsetof(Actor_list,actor)==4,"Actor list ABI");
+_Static_assert(sizeof(Actor_info)==4+8*ACTOR_PART_NUM,"Actor registry ABI");
+static unsigned int ac_scene_attaches,ac_scene_detaches;
+static Actor_info *ac_scene_walk_info;
+static ACTOR *ac_scene_pending[mAc_MAX_ACTORS];
+static unsigned int ac_scene_pending_count,ac_scene_walk_phase;
+static unsigned int ac_scene_walks,ac_scene_visits,ac_scene_retirements;
+int ac_scene_actor_validate(const Actor_info *info){
+    if(!info||info->total_num<0||info->total_num>mAc_MAX_ACTORS)return -1;
+    unsigned int total=0;
+    for(unsigned int part=0;part<ACTOR_PART_NUM;++part){
+        const ACTOR *previous=0,*actor=info->list[part].actor;unsigned int count=0;
+        while(actor){
+            if(++count>mAc_MAX_ACTORS||actor->part!=part||actor->prev_actor!=previous)return -2;
+            previous=actor;actor=actor->next_actor;
+        }
+        if((int)count!=info->list[part].num_actors)return -3;
+        total+=count;
+    }
+    return (int)total==info->total_num?0:-4;
+}
+int ac_scene_actor_contains(const Actor_info *info,const ACTOR *actor){
+    if(!actor||ac_scene_actor_validate(info))return -1;
+    for(unsigned int part=0;part<ACTOR_PART_NUM;++part)
+        for(const ACTOR *p=info->list[part].actor;p;p=p->next_actor)if(p==actor)return 1;
+    return 0;
+}
+int ac_scene_actor_attach(Actor_info *info,ACTOR *actor,unsigned int part){
+    if(ac_scene_walk_info)return -2;
+    if(!actor||part>=ACTOR_PART_NUM||ac_scene_actor_validate(info)||
+       info->total_num>=mAc_MAX_ACTORS||ac_scene_actor_contains(info,actor)!=0||
+       actor->prev_actor||actor->next_actor)return -1;
+    Actor_info_part_new(info,actor,(u8)part);++ac_scene_attaches;
+    return ac_scene_actor_validate(info);
+}
+static int ac_scene_actor_unlink(Actor_info *info,ACTOR *actor){
+    if(ac_scene_actor_contains(info,actor)!=1)return -1;
+    Actor_info_part_delete(info,actor);++ac_scene_detaches;
+    return ac_scene_actor_validate(info);
+}
+int ac_scene_actor_detach(Actor_info *info,ACTOR *actor){
+    if(ac_scene_walk_info)return -2;
+    return ac_scene_actor_unlink(info,actor);
+}
+int ac_scene_actor_stats(void){return ac_scene_attaches==6&&ac_scene_detaches==6?0:-1;}
+int ac_scene_actor_defer_remove(Actor_info *info,ACTOR *actor){
+    if(!info||ac_scene_walk_info!=info||ac_scene_walk_phase!=1||
+       ac_scene_actor_contains(info,actor)!=1)return -1;
+    for(unsigned int i=0;i<ac_scene_pending_count;++i)if(ac_scene_pending[i]==actor)return 0;
+    if(ac_scene_pending_count>=mAc_MAX_ACTORS)return -2;
+    ac_scene_pending[ac_scene_pending_count++]=actor;return 0;
+}
+static void ac_scene_walk_clear(void){
+    for(unsigned int i=0;i<ac_scene_pending_count;++i)ac_scene_pending[i]=0;
+    ac_scene_pending_count=0;ac_scene_walk_phase=0;ac_scene_walk_info=0;
+}
+int ac_scene_actor_walk(Actor_info *info,ACSceneActorVisit visit,ACSceneActorRemoved removed,
+                        void *user,unsigned int *visited){
+    if(ac_scene_walk_info||!visit||!visited||ac_scene_actor_validate(info))return -1;
+    *visited=0;ac_scene_walk_info=info;ac_scene_walk_phase=1;
+    for(unsigned int part=0;part<ACTOR_PART_NUM;++part){
+        for(ACTOR *actor=info->list[part].actor;actor;actor=actor->next_actor){
+            int result=visit(actor,user);++*visited;
+            if(result||ac_scene_actor_validate(info)){ac_scene_walk_clear();return -2;}
+        }
+    }
+    ac_scene_walk_phase=2;
+    for(unsigned int i=0;i<ac_scene_pending_count;++i){
+        ACTOR *actor=ac_scene_pending[i];
+        if(ac_scene_actor_unlink(info,actor)){ac_scene_walk_clear();return -3;}
+        if(removed)removed(actor,user);
+        if(ac_scene_actor_validate(info)){ac_scene_walk_clear();return -3;}
+    }
+    ++ac_scene_walks;ac_scene_visits+=*visited;ac_scene_retirements+=ac_scene_pending_count;
+    ac_scene_walk_clear();return 0;
+}
+void ac_scene_actor_traversal_counts(unsigned int counts[3]){
+    if(counts){counts[0]=ac_scene_walks;counts[1]=ac_scene_visits;counts[2]=ac_scene_retirements;}
+}
+int ac_scene_actor_traversal_stats(void){
+#ifdef AC_RESIDENT_SCENE
+    const unsigned int expected_visits=3603;
+#else
+    const unsigned int expected_visits=3599;
+#endif
+    return !ac_scene_walk_info&&!ac_scene_pending_count&&!ac_scene_walk_phase&&
+           ac_scene_walks==1803&&ac_scene_visits==expected_visits&&ac_scene_retirements==3?0:-1;
+}
+#endif
