scrollbarvertical {
    width: 10dp;
    margin: 6dp 5dp 6dp 0;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 10dp;
    background-color: var(--color-scroll-track);
    border-radius: var(--radius-small);
}

scrollbarvertical sliderbar {
    width: 10dp;
    min-height: 28dp;
    background-color: var(--color-scroll-thumb);
    border-radius: var(--radius-small);
    transition: background-color 0.14s linear-in-out;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
    background-color: var(--color-accent-bright);
}

scrollbarhorizontal,
scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc,
scrollbarhorizontal slidertrack,
scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

section-heading {
    font-family: var(--font-family-heading);
    font-weight: bold;
    font-size: var(--font-size-xl);
    color: var(--color-heading);
    letter-spacing: 0.5dp;
}

section-heading:not(:first-of-type) {
    padding-top: 14dp;
}

button {
    padding: 9dp 18dp;
    text-align: center;
    font-family: var(--font-family-body);
    font-size: var(--font-size-lg);
    font-weight: normal;
    color: var(--color-text);
    background-color: var(--button-background);
    border-radius: var(--radius-button);
    transition: background-color 0.1s linear-in-out, transform 0.08s linear-in-out;
    cursor: pointer;
    focus: auto;
}

button:not(:disabled):hover,
button:not(:disabled):focus-visible {
    color: var(--color-text-strong);
    background-color: var(--button-background-hover);
}

button:not(:disabled):selected {
    color: var(--color-text-on-accent);
    background-color: var(--color-accent);
}

button:not(:disabled):active {
    color: var(--color-text-strong);
    background-color: var(--button-background-active);
    transform: scale(0.98);
}

button:disabled {
    opacity: var(--button-opacity-disabled);
    cursor: default;
}

button.modal-btn {
    flex: 1 1 0;
    text-align: center;
}

select-button {
    display: flex;
    align-items: center;
    gap: 10dp;
    min-height: 48dp;
    padding: 9dp var(--space-lg);
    color: var(--color-text);
    background-color: var(--button-background);
    border-radius: var(--radius-control);
    transition: background-color 0.1s linear-in-out, transform 0.08s linear-in-out;
    cursor: pointer;
    focus: auto;
}

select-button:not(:disabled):hover,
select-button:not(:disabled):focus-visible {
    color: var(--color-text-strong);
    background-color: var(--button-background-hover);
}

select-button:not(:disabled):selected {
    color: var(--color-text-strong);
    background-color: var(--button-background-selected);
}

select-button:not(:disabled):active {
    color: var(--color-text-strong);
    background-color: var(--button-background-active);
    transform: scale(0.99);
}

select-button:not(:disabled):hover value:not(.modified),
select-button:not(:disabled):focus-visible value:not(.modified),
select-button:not(:disabled):selected value:not(.modified),
select-button:not(:disabled):active value:not(.modified) {
    color: var(--color-text-strong);
}

select-button:disabled {
    opacity: var(--button-opacity-disabled);
    cursor: default;
}

select-button key {
    flex: 0 1 auto;
    font-family: var(--font-family-heading);
    font-weight: bold;
    font-size: var(--font-size-md);
}

select-button value {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: right;
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
}

select-button value.modified {
    font-weight: bold;
    color: var(--color-modified);
}

select-button > icon {
    display: none;
    flex: 0 0 auto;
}

select-button.has-icon > icon,
select-button.group-button > icon {
    display: inline-block;
}

select-button.group-button > icon {
    flex: 0 0 24dp;
    margin-left: auto;
    width: 24dp;
    height: 24dp;
    font-size: var(--font-size-4xl);
    decorator: text("&#xe5cc;" center center);
}

select-button.group-button value,
select-button.dropdown-button > icon {
    display: none;
}

select-button.dropdown-button {
    padding: 0 var(--space-sm) 0 var(--space-lg);
    gap: var(--space-xs);
}

select-button.dropdown-button:not(.has-key) {
    gap: 0;
}

select-button.dropdown-button:not(.has-key) key {
    display: none;
}

select-button.dropdown-button:not(.has-key) value {
    text-align: left;
    color: var(--color-text);
}

select-button.dropdown-button dropdown-indicator {
    display: block;
    flex: 0 0 32dp;
    width: 32dp;
    height: 48dp;
    color: var(--color-text-muted);
    font-family: var(--font-family-icons);
    font-size: var(--font-size-3xl);
    font-weight: normal;
    line-height: 48dp;
    text-align: center;
    transition: transform 0.1s linear-in-out;
}

select-button.dropdown-button:not(:disabled):hover dropdown-indicator,
select-button.dropdown-button:not(:disabled):focus-visible dropdown-indicator,
select-button.dropdown-button:not(:disabled):active dropdown-indicator {
    color: var(--color-text-strong);
}

select-button.dropdown-button.expanded dropdown-indicator {
    transform: rotate(180deg);
}

select-button adjust-value {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
}

select-button adjust-value value {
    flex: 0 1 auto;
}

select-button .adjust-arrow {
    flex: 0 0 auto;
    padding: 0 6dp;
    font-family: var(--font-family-icons);
    font-size: var(--font-size-lg);
    font-weight: normal;
    color: var(--color-text-muted);
    focus: none;
}

select-button:not(:disabled):hover .adjust-arrow:not(.modified),
select-button:not(:disabled):focus-visible .adjust-arrow:not(.modified),
select-button:not(:disabled):selected .adjust-arrow:not(.modified),
select-button:not(:disabled):active .adjust-arrow:not(.modified) {
    color: var(--color-text-strong);
}

select-button .adjust-arrow.modified {
    color: var(--color-modified);
}

select-button .adjust-arrow.unavailable {
    opacity: 0.3;
    cursor: default;
}

select-button input {
    text-align: right;
    font-family: var(--font-family-body);
    font-size: var(--font-size-lg);
    background-color: transparent;
}

icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: middle;
    font-family: var(--font-family-icons);
    font-weight: normal;
}

icon.warning {
    decorator: text("&#xe002;" center center);
}

icon.error {
    decorator: text("&#xe000;" center center);
}

icon.verifying {
    decorator: text("&#xe8b5;" center center);
}

icon.celebration {
    decorator: text("&#xea65;" center center);
}

icon.question-mark {
    decorator: text("&#xeb8b;" center center);
}

icon.train {
    decorator: text("&#xe570;" center center);
}

progress {
    display: block;
    width: 100%;
    height: 8dp;
    margin: var(--space-xs) 0;
    background-color: rgba(255, 255, 255, 14%);
    border-radius: 4dp;
}

progress fill {
    background-color: var(--color-dialog-accent);
    border-radius: 4dp;
}
