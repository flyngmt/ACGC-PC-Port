*, *:before, *:after {
    box-sizing: border-box;
}

body {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0 16dp;
    font-family: "ACGC Body";
    font-weight: normal;
    font-size: 18dp;
}

button {
    cursor: pointer;
    focus: auto;
}

popup {
    display: flex;
    position: relative;
    flex: 0 0 auto;
    width: auto;
    max-width: 100%;
    height: 72dp;
    margin-top: 18dp;
    overflow: hidden;
    color: var(--text);
    background-color: var(--surface);
    border: 4dp var(--surface-border);
    border-radius: 36dp;
    box-shadow: 0 10dp 28dp 2dp var(--shadow);
    filter: opacity(0);
    transform: translateY(-104dp);
    transition: filter transform 0.18s cubic-in-out;
}

popup[open] {
    filter: opacity(1);
    transform: translateY(0);
}

popup tab-bar {
    flex: 0 0 auto;
}
