*, *:before, *:after {
    box-sizing: border-box;
}

body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "ACGC UI";
    font-weight: normal;
    font-size: 18dp;
    color: #ECFDF5;
}

button {
    cursor: pointer;
    focus: auto;
}

popup {
    width: 100%;
    display: flex;
    align-items: stretch;
    height: 64dp;
    border-radius: 0 0 20dp 20dp;
    background-color: rgba(16, 18, 22, 5%);
    /* border-bottom: 2dp #10B981; */
    backdrop-filter: blur(6dp) glass(20dp 35dp 0.2 rgba(20, 22, 26, 10%) 1.15 0.15 0.01);
    transform: translateY(-64dp);
    transition: transform 0.2s cubic-in-out;
    overflow: hidden;
}

popup[open] {
    transform: translateY(0);
}

popup tab-bar {
    flex: 1 1 0;
}
