tab-bar {
    display: flex;
    position: relative;
    min-width: 0;
    overflow: auto hidden;
    clip: always;
}

tab-bar scrollbarhorizontal,
tab-bar scrollbarhorizontal sliderarrowdec,
tab-bar scrollbarhorizontal sliderarrowinc,
tab-bar scrollbarhorizontal slidertrack,
tab-bar scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

tab-bar tab {
    flex: 0 0 auto;
    margin: 4dp;
    padding: 0 20dp;
    line-height: 56dp;
    white-space: nowrap;
    color: #74684f;
    background-color: rgba(255, 226, 122, 0%);
    border-radius: 24dp;
    transition: background-color 0.1s linear-in-out, transform 0.08s linear-in-out;
    cursor: pointer;
    focus: auto;
    font-family: "ACGC Heading";
    font-weight: bold;
    font-size: 17dp;
}

tab-bar tab:focus-visible,
tab-bar tab:hover {
    color: #65543c;
    background-color: #ffe27a;
}

tab-bar tab:selected {
    color: #fffdf3;
    background-color: #e98424;
}

tab-bar tab:active {
    color: #65543c;
    background-color: #ffc742;
    transform: scale(0.97);
}

tab-bar[closable] tab-end-spacer {
    display: block;
    flex: 0 0 68dp;
    width: 68dp;
    pointer-events: none;
}

tab-bar[closable] close,
window > close {
    display: block;
    position: absolute;
    top: 8dp;
    right: 8dp;
    z-index: 1;
    width: 48dp;
    height: 48dp;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    font-size: 24dp;
    color: #fffdf3;
    background-color: #e98424;
    border-radius: 24dp;
    decorator: text("&#xe5cd;" center center);
    transition: background-color 0.1s linear-in-out, transform 0.08s linear-in-out;
    cursor: pointer;
    focus: auto;
}

tab-bar[closable] close:hover,
tab-bar[closable] close:focus-visible,
window > close:hover,
window > close:focus-visible {
    background-color: #ffc742;
}

tab-bar[closable] close:active,
window > close:active {
    background-color: #ef942c;
    transform: scale(0.94);
}

window > close {
    top: 16dp;
    right: 16dp;
}
