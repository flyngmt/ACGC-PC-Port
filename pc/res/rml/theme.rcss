body {
    --font-family-body: ACGC Body;
    --font-family-heading: ACGC Heading;
    --font-family-icons: Material Symbols Rounded;
    --font-size-xs: 15dp;
    --font-size-sm: 16dp;
    --font-size-md: 17dp;
    --font-size-base: 18dp;
    --font-size-lg: 19dp;
    --font-size-xl: 20dp;
    --font-size-2xl: 21dp;
    --font-size-3xl: 24dp;
    --font-size-4xl: 25dp;
    --space-2xs: 2dp;
    --space-xs: 4dp;
    --space-sm: 8dp;
    --space-md: 12dp;
    --space-lg: 16dp;
    --space-xl: 24dp;
    --space-2xl: 32dp;
    --radius-small: 5dp;
    --radius-button: 18dp;
    --radius-control: 22dp;
    --radius-tab: 24dp;
    --radius-window: 36dp;
    --radius-window-compact: 28dp;
    --radius-modal: 42dp;
    --border-width: 2dp;
    --border-window-width: 4dp;
    --button-color: var(--color-text);
    --button-background: var(--color-control);
    --button-background-hover: var(--color-highlight);
    --button-background-selected: var(--color-selected);
    --button-background-active: var(--color-pressed);
    --button-opacity-disabled: 0.38;
    --color-dialog-text: #f4ffff;
    --color-dialog-muted: rgba(226, 244, 249, 72%);
    --color-dialog-surface: rgba(29, 57, 81, 94%);
    --color-dialog-border: rgba(164, 201, 217, 72%);
    --color-dialog-shadow: rgba(4, 17, 29, 60%);
    --color-dialog-accent: #ffd65a;
    --color-dialog-button: #fff1a8;
    --color-dialog-button-active: #ffc429;
    --color-dialog-button-text: #4f493d;
}

.theme-day {
    --color-background: #f3e4b9;
    --color-surface: #fffbe7;
    --color-surface-border: #f5e7bd;
    --color-surface-raised: #f8edcfd6;
    --color-surface-sunken: #fff3d2d6;
    --color-divider: #ead9ad;
    --color-text: #655b47;
    --color-text-muted: #74684f;
    --color-text-faint: #655b47ad;
    --color-text-strong: #65543c;
    --color-text-on-accent: #fffdf3;
    --color-heading: #d97821;
    --color-warning: #d97821;
    --color-control: #ffffff85;
    --color-control-strong: #ffffff99;
    --color-highlight: #ffe27a;
    --color-selected: #ffd25a;
    --color-pressed: #ffc742;
    --color-accent: #e98424;
    --color-accent-bright: #ef942c;
    --color-shadow: #362d1d6b;
    --color-shadow-soft: #362d1d52;
    --color-scroll-track: #d4b97d40;
    --color-scroll-thumb: #d38b2e8c;
    --color-positive: #198d79;
    --color-positive-soft: #89d2c2;
    --color-modified: #009c9b;
    --color-status-bad: #9a7350;
    --color-status-info: #247c9a;
    --color-modal-button: #fff1a8;
    --color-modal-button-text: #4f493d;
    --color-modal-button-text-strong: #4f493d;
    --color-modal-button-hover: #ffd65a;
    --color-modal-button-active: #ffc429;
    --color-pattern-tint: #ffffff;
}

.theme-night {
    --color-background: #131a2a;
    --color-surface: #1e273b;
    --color-surface-border: #34405b;
    --color-surface-raised: #28334cd6;
    --color-surface-sunken: #182033d6;
    --color-divider: #3a4763;
    --color-text: #ebe4d1;
    --color-text-muted: #b9b19f;
    --color-text-faint: #ebe4d1a3;
    --color-text-strong: #222838;
    --color-text-on-accent: #fffdf3;
    --color-heading: #8fa8e8;
    --color-warning: #f2a654;
    --color-control: #ffffff12;
    --color-control-strong: #ffffff1a;
    --color-highlight: #d8dff2;
    --color-selected: #c9d3ee;
    --color-pressed: #b9c6e6;
    --color-accent: #5b7fd1;
    --color-accent-bright: #7896de;
    --color-shadow: #03071299;
    --color-shadow-soft: #03071280;
    --color-scroll-track: #9fb0d529;
    --color-scroll-thumb: #7896de8c;
    --color-positive: #57c4ae;
    --color-positive-soft: #3f8c7f;
    --color-modified: #5ccfce;
    --color-status-bad: #c9a582;
    --color-status-info: #74bfdc;
    --color-modal-button: #ffffff14;
    --color-modal-button-text: #ebe4d1;
    --color-modal-button-text-strong: #222838;
    --color-modal-button-hover: #d8dff2;
    --color-modal-button-active: #b9c6e6;
    --color-pattern-tint: #a9bbeb;
}
