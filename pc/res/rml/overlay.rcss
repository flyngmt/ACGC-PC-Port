body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-size: var(--font-size-base);
}

typing-status {
    position: absolute;
    display: flex;
    align-items: center;
    top: 20dp;
    left: 50%;
    padding: 0.5em 0.72em;
    gap: 0.5em;
    color: var(--color-text);
    background-color: var(--color-surface);
    border: 4dp var(--color-surface-border);
    border-radius: 1.5em;
    box-shadow: 0 0.42em 1.17em 0.08em var(--color-shadow-soft);
    filter: opacity(0);
    transform: translateY(-0.67em);
    transition: filter transform 0.18s cubic-in-out;
}

typing-status[open] {
    filter: opacity(1);
    transform: translateY(0);
}

typing-status label {
    font-family: var(--font-family-heading);
    font-weight: bold;
    color: var(--color-text);
}

typing-status key {
    padding: 0.17em 0.5em;
    border-radius: 0.67em;
    background-color: var(--color-highlight);
    font-family: var(--font-family-heading);
    font-weight: bold;
    font-size: 0.83em;
    color: var(--color-text-strong);
}

typing-status state {
    min-width: 2.6em;
    padding: 0.17em 0.5em;
    border-radius: 0.67em;
    text-align: center;
    color: var(--color-text-muted);
    background-color: var(--color-surface-raised);
    font-weight: bold;
    transition: color background-color 0.14s linear-in-out;
}

typing-status[active] {
    border-color: var(--color-positive-soft);
}

typing-status[active] state {
    color: var(--color-text-on-accent);
    background-color: var(--color-positive);
}
