*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    font-family: "ACGC UI";
    font-size: 16dp;
    color: #ECFDF5;
}

typing-status {
    position: absolute;
    display: none;
    align-items: center;
    top: 20dp;
    left: 20dp;
    padding: 0.5em 0.625em;
    gap: 0.5em;
    border: 0.0625em rgba(255, 255, 255, 24%);
    border-radius: 0.625em;
    background-color: rgba(16, 18, 22, 72%);
    backdrop-filter: blur(0.25em);
}

typing-status[open] {
    display: flex;
}

typing-status label {
    color: rgba(236, 253, 245, 82%);
}

typing-status key {
    padding: 0.154em 0.462em;
    border: 0.077em rgba(255, 255, 255, 30%);
    border-radius: 0.308em;
    background-color: rgba(255, 255, 255, 10%);
    font-size: 0.8125em;
}

typing-status state {
    min-width: 1.5em;
    color: #A7B0BC;
    font-weight: bold;
}

typing-status[active] {
    border-color: rgba(16, 185, 129, 55%);
}

typing-status[active] state {
    color: #34D399;
}
