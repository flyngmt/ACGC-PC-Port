*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    font-family: "ACGC Body";
    font-weight: normal;
    font-size: 18dp;
}

typing-status {
    position: absolute;
    display: flex;
    align-items: center;
    top: 20dp;
    left: 50%;
    padding: 0.5em 0.72em;
    gap: 0.5em;
    color: var(--text);
    background-color: var(--surface);
    border: 4dp var(--surface-border);
    border-radius: 1.5em;
    box-shadow: 0 0.42em 1.17em 0.08em var(--shadow-soft);
    filter: opacity(0);
    transform: translateY(-0.67em);
    transition: filter transform 0.18s cubic-in-out;
}

typing-status[open] {
    filter: opacity(1);
    transform: translateY(0);
}

typing-status label {
    font-family: "ACGC Heading";
    font-weight: bold;
    color: var(--text);
}

typing-status key {
    padding: 0.17em 0.5em;
    border-radius: 0.67em;
    background-color: var(--highlight);
    font-family: "ACGC Heading";
    font-weight: bold;
    font-size: 0.83em;
    color: var(--text-strong);
}

typing-status state {
    min-width: 2.6em;
    padding: 0.17em 0.5em;
    border-radius: 0.67em;
    text-align: center;
    color: var(--text-muted);
    background-color: var(--surface-raised);
    font-weight: bold;
    transition: color background-color 0.14s linear-in-out;
}

typing-status[active] {
    border-color: var(--positive-soft);
}

typing-status[active] state {
    color: var(--text-on-accent);
    background-color: var(--positive);
}
