*, *:before, *:after {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    font-family: "ACGC Body";
    font-weight: normal;
    font-size: 18dp;
    color: #655b47;
}

typing-status {
    position: absolute;
    display: flex;
    align-items: center;
    top: 20dp;
    left: 50%;
    padding: 0.5em 0.72em;
    gap: 0.5em;
    color: #655b47;
    background-color: rgba(255, 251, 231, 94%);
    border: 4dp #f5e7bd;
    border-radius: 1.5em;
    box-shadow: 0 0.42em 1.17em 0.08em rgba(54, 45, 29, 34%);
    filter: opacity(0);
    transform: translateY(-0.67em);
    transition: filter transform 0.18s cubic-in-out;
}

typing-status[open] {
    filter: opacity(1);
    transform: translateY(0);
}

typing-status label {
    font-family: "ACGC Heading";
    font-weight: bold;
    color: #655b47;
}

typing-status key {
    padding: 0.17em 0.5em;
    border-radius: 0.67em;
    background-color: #ffe27a;
    font-family: "ACGC Heading";
    font-weight: bold;
    font-size: 0.83em;
    color: #65543c;
}

typing-status state {
    min-width: 2.6em;
    padding: 0.17em 0.5em;
    border-radius: 0.67em;
    text-align: center;
    color: #74684f;
    background-color: #f8edcf;
    font-weight: bold;
    transition: color background-color 0.14s linear-in-out;
}

typing-status[active] {
    border-color: #89d2c2;
}

typing-status[active] state {
    color: #fffdf3;
    background-color: #198d79;
}
