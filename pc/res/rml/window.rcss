*, *:before, *:after {
    box-sizing: border-box;
}

body {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 64dp;
    font-family: "ACGC Body";
    font-weight: normal;
    font-style: normal;
    font-size: 16dp;
    color: #655b47;
}

b {
    font-weight: bold;
}

window {
    display: flex;
    flex-flow: column;
    position: relative;
    height: 100%;
    width: 100%;
    max-width: 1088dp;
    max-height: 768dp;
    margin: auto;
    overflow: hidden;
    background-color: #fffbe7;
    border: 4dp #f5e7bd;
    border-radius: 36dp;
    box-shadow: 0 14dp 36dp 2dp rgba(54, 45, 29, 42%);
    filter: opacity(0);
    transform: scale(0.96);
    transform-origin: center;
    transition: filter transform 0.18s cubic-in-out;
}

window.small {
    height: auto;
    width: auto;
}

window[open] {
    filter: opacity(1);
    transform: scale(1);
}

window-background {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
}

window > tab-bar,
window > content,
window > .modal-dialog {
    position: relative;
    z-index: 1;
}

@media (max-height: 640dp) {
    body {
        padding: 16dp;
    }

    window {
        border-radius: 28dp;
        box-shadow: none;
    }
}

window tab-bar {
    flex: 0 0 72dp;
    height: 72dp;
    padding: 4dp 8dp;
    background-color: rgba(248, 237, 207, 84%);
    border-bottom: 2dp #ead9ad;
}

window content {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

window content pane {
    display: flex;
    flex-flow: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    padding: 26dp;
    padding-bottom: 0dp;
    gap: 10dp;
    overflow: hidden auto;
    font-size: 19dp;
}

window content pane:last-of-type {
    background-color: rgba(255, 243, 210, 84%);
    border-left: 2dp #efe1ba;
}

window content pane > * {
    flex: 0 0 auto;
}

window content pane:last-of-type > div {
    line-height: 1.55;
    word-break: break-word;
}

.data-folder-current {
    display: block;
    font-size: 16dp;
    color: rgba(101, 91, 71, 68%);
}

window content pane > spacer {
    display: block;
    flex: 0 0 16dp;
    height: 16dp;
    pointer-events: none;
}

scrollbarvertical {
    width: 10dp;
    margin: 6dp 5dp 6dp 0;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 10dp;
    background-color: rgba(212, 185, 125, 25%);
    border-radius: 5dp;
}

scrollbarvertical sliderbar {
    width: 10dp;
    min-height: 28dp;
    background-color: rgba(211, 139, 46, 55%);
    border-radius: 5dp;
    transition: background-color 0.14s linear-in-out;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
    background-color: #ef942c;
}

scrollbarhorizontal,
scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc,
scrollbarhorizontal slidertrack,
scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

.section-heading {
    font-family: "ACGC Heading";
    font-weight: bold;
    font-size: 20dp;
    color: #d97821;
    letter-spacing: 0.5dp;
}

.section-heading:not(:first-of-type) {
    padding-top: 14dp;
}

button {
    padding: 9dp 18dp;
    text-align: center;
    font-family: "ACGC Body";
    font-size: 19dp;
    font-weight: normal;
    color: #655b47;
    background-color: rgba(255, 255, 255, 52%);
    border-radius: 22dp;
    transition: background-color 0.1s linear-in-out, transform 0.08s linear-in-out;
    cursor: pointer;
    focus: auto;
}

button:not(:disabled):hover,
button:not(:disabled):focus-visible {
    background-color: #ffe27a;
}

button:not(:disabled):selected {
    color: #fffdf3;
    background-color: #e98424;
}

button:not(:disabled):active {
    background-color: #ffc742;
    transform: scale(0.98);
}

button:disabled {
    opacity: 0.38;
    cursor: default;
}

button.modal-btn {
    flex: 1 1 0;
    text-align: center;
}

select.dropdown {
    display: block;
    width: 100%;
    height: 48dp;
    color: #655b47;
    background-color: rgba(255, 255, 255, 52%);
    border-radius: 22dp;
    cursor: pointer;
    focus: auto;
    /* Let Up/Down leave the closed dropdown so keyboard and controller
       navigation can reach the rest of the pane. */
    nav-up: auto;
    nav-down: auto;
}

select.dropdown selectvalue {
    width: auto;
    height: 48dp;
    margin-right: 48dp;
    padding: 0 16dp;
    line-height: 48dp;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 19dp;
}

select.dropdown selectarrow {
    width: 48dp;
    height: 48dp;
    color: #74684f;
    font-family: "Material Symbols Rounded";
    font-size: 24dp;
    decorator: text("&#xe5cf;" center center);
}

select.dropdown:hover,
select.dropdown:focus-visible {
    background-color: #ffe27a;
}

select.dropdown:active {
    background-color: #ffc742;
}

select.dropdown selectbox {
    width: 100%;
    max-height: 360dp;
    margin-top: 4dp;
    padding: 6dp;
    color: #655b47;
    background-color: #fffbe7;
    border: 2dp #ead9ad;
    border-radius: 18dp;
    box-shadow: 0 8dp 20dp 2dp rgba(54, 45, 29, 32%);
}

select.dropdown selectbox option {
    padding: 9dp 12dp;
    background-color: transparent;
    border-radius: 12dp;
}

select.dropdown selectbox option:hover {
    background-color: #ffe27a;
}

select.dropdown selectbox option:checked {
    color: #fffdf3;
    background-color: #e98424;
}

select-button {
    display: flex;
    align-items: center;
    gap: 10dp;
    min-height: 48dp;
    padding: 9dp 16dp;
    color: #655b47;
    background-color: rgba(255, 255, 255, 52%);
    border-radius: 22dp;
    transition: background-color 0.1s linear-in-out, transform 0.08s linear-in-out;
    cursor: pointer;
    focus: auto;
}

select-button:not(:disabled):hover,
select-button:not(:disabled):focus-visible {
    background-color: #ffe27a;
}

select-button:not(:disabled):selected {
    background-color: #ffd25a;
}

select-button:not(:disabled):active {
    background-color: #ffc742;
    transform: scale(0.99);
}

select-button:disabled {
    opacity: 0.38;
    cursor: default;
}

select-button key {
    flex: 0 1 auto;
    font-family: "ACGC Heading";
    font-weight: bold;
    font-size: 17dp;
    color: #655b47;
}

select-button value {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-align: right;
    font-size: 19dp;
    color: #74684f;
}

select-button value.modified {
    font-weight: bold;
    color: #009c9b;
}

select-button.adjustable value {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    overflow: visible;
}

select-button .value-label {
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

select-button .adjust-arrow {
    flex: 0 0 auto;
    padding: 0 6dp;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    focus: none;
}

select-button .adjust-arrow.unavailable {
    opacity: 0.3;
    cursor: default;
}

select-button input {
    text-align: right;
    font-family: "ACGC Body";
    font-size: 19dp;
    color: #655b47;
    background-color: transparent;
}

icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: middle;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
}

icon.warning {
    decorator: text("&#xe002;" center center);
}

icon.error {
    decorator: text("&#xe000;" center center);
}

icon.verifying {
    decorator: text("&#xe8b5;" center center);
}

icon.celebration {
    decorator: text("&#xea65;" center center);
}

icon.question-mark {
    decorator: text("&#xeb8b;" center center);
}

icon.train {
    decorator: text("&#xe570;" center center);
}

progress {
    display: block;
    width: 100%;
    height: 8dp;
    margin: 4dp 0;
    background-color: rgba(255, 255, 255, 14%);
    border-radius: 4dp;
}

progress fill {
    background-color: #ffd65a;
    border-radius: 4dp;
}

.verification-progress {
    display: flex;
    flex-direction: column;
    gap: 10dp;
    width: 100%;
}

.verification-file {
    display: block;
    font-size: 18dp;
    color: #f4ffff;
}

.verification-detail {
    display: block;
    font-size: 15dp;
    color: rgba(226, 244, 249, 72%);
}

window.modal {
    max-width: 680dp;
    color: #f4ffff;
    background-color: rgba(29, 57, 81, 94%);
    border: 4dp rgba(164, 201, 217, 72%);
    border-radius: 42dp;
    box-shadow: 0 16dp 42dp 4dp rgba(4, 17, 29, 60%);
}

window.modal.danger {
    border-color: #ef942c;
}

window.modal.light {
    color: #655b47;
    background-color: rgba(255, 251, 231, 96%);
    border-color: #f5e7bd;
    box-shadow: 0 14dp 36dp 2dp rgba(54, 45, 29, 42%);
}

.modal-dialog {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    padding: 32dp;
    gap: 22dp;
    flex: 0 1 auto;
    text-align: left;
}

.modal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex: 0 0 auto;
    gap: 16dp;
}

.modal-header icon {
    flex: 0 0 36dp;
    width: 36dp;
    height: 36dp;
    line-height: 36dp;
    text-align: center;
    font-size: 25dp;
    color: #ffd65a;
    background-color: rgba(255, 255, 255, 12%);
    border-radius: 18dp;
}

.modal-title {
    display: block;
    flex: 1 1 auto;
    font-family: "ACGC Heading";
    font-weight: bold;
    font-size: 24dp;
    color: #f4ffff;
}

window.modal.danger .modal-title,
window.modal.danger .modal-header icon {
    color: #ffd65a;
}

window.modal.light .modal-title {
    color: #655b47;
}

window.modal.light .modal-header icon {
    color: #d97821;
    background-color: rgba(243, 228, 185, 72%);
}

window.modal.light .modal-header icon.warning {
    decorator: text("&#xe002;" center 46%);
}

.modal-body {
    display: block;
    width: 100%;
    flex: 0 1 auto;
    min-width: 0;
    font-size: 21dp;
    line-height: 1.5;
    color: #f4ffff;
    font-weight: normal;
}

window.modal.light .modal-body {
    color: #655b47;
}

.modal-body span.tip {
    font-size: 15dp;
    color: rgba(226, 244, 249, 72%);
}

.modal-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 14dp;
    width: 100%;
    flex: 0 0 auto;
    padding-top: 4dp;
}

window.modal button {
    color: #4f493d;
    background-color: #fff1a8;
}

window.modal button:not(:disabled):hover,
window.modal button:not(:disabled):focus-visible {
    color: #4f493d;
    background-color: #ffd65a;
}

window.modal button:not(:disabled):selected,
window.modal button:not(:disabled):active {
    color: #4f493d;
    background-color: #ffc429;
}
