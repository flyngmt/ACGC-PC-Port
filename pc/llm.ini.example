[llm]
provider = gemini
endpoint = https://generativelanguage.googleapis.com
api_key = YOUR_GEMINI_API_KEY
model = gemini-3.5-flash-lite
timeout_ms = 8000
max_tokens = 150
temperature = 0.8
enabled = 0

# 0-100: % chance LLM replaces a villager greeting (0=never, 100=always)
chat_chance = 20

# Topic distribution percentages (should sum to ~100)
topic_hobbies_pct = 50
topic_relations_pct = 20
topic_smalltalk_pct = 30

# % chance past memories are injected into the prompt
memory_influence_pct = 25

# Extra prompt text appended to every LLM request
prompt_extra =
