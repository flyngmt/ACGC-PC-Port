# IDE folders
.idea/
.vs/
.vscode/*

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Game ROM (copyrighted, never commit)
rom/

# Build files
build/
build32/
.ninja_*
build.ninja

# PC port build directories
pc/build32-*/

# Runtime-generated config files (contain secrets / user settings, never commit)
pc/build32-*/bin/llm.ini
pc/build32-*/bin/settings.ini
pc/build32-*/bin/keybindings.ini

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
!requirements.txt
*.exe

# For saving work files into (like IDB)
temp/

# Ignore the N64 SDK headers since we download them
# NOTE: include/PR/gbi.h and include/PR/ultratypes.h are force-tracked
# (git add -f) because they have TARGET_PC modifications for LE bitfields.
# configure.py skips download when they already exist.
include/PR/
include/gcc/
include/compiler/gcc/stdlib.h
